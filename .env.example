# ==============================================================================
# Goswami X Software — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC SITE URL (Production / Canonical / Metadata)
# ------------------------------------------------------------------------------
# In production on Vercel: https://goswami-x-software.vercel.app
NEXT_PUBLIC_SITE_URL=https://goswami-x-software.vercel.app

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION & DATABASE (Primary Auth & Storage)
# ------------------------------------------------------------------------------
# Project URL & Public/Publishable Key (Client-Safe via NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# Supabase Secret / Service Role Key (Server-Side Only — NEVER Expose to Browser)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION (Client-Safe via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleApiKey1234567890abcdef
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=goswami-x-software.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=goswami-x-software
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=goswami-x-software.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK CONFIGURATION (Server-Side Only — NEVER Expose to Browser)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=goswami-x-software
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@goswami-x-software.iam.gserviceaccount.com
# For FIREBASE_PRIVATE_KEY, escape newlines as \n or enclose in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. OFFICIAL META WHATSAPP CLOUD API CONFIGURATION (Server-Side Only)
# ------------------------------------------------------------------------------
# Obtain from Meta for Developers (developers.facebook.com) > Your App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_ACCESS_TOKEN=EAAG...Permanent_Or_System_User_Access_Token...
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000
# Webhook verification token chosen by you to verify webhook URL in Meta App Dashboard
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_random_webhook_verify_token_here
# App Secret from Meta App Dashboard > App Settings > Basic > App Secret (used to verify HMAC-SHA256 signature)
WHATSAPP_APP_SECRET=your_meta_app_secret_here
# Official WhatsApp business phone number for display/links (E.164 without +, e.g., 919876543210)
WHATSAPP_OFFICIAL_NUMBER=910000000000
# Optional: Approved Meta Template Name for OTP authentication (default: text message if empty)
# Example template name: auth_verification_code
WHATSAPP_TEMPLATE_NAME=
# Set to true if the approved WhatsApp template contains a URL/copy_code button component (default: false)
WHATSAPP_TEMPLATE_HAS_BUTTON=false

# ------------------------------------------------------------------------------
# 5. SERVER SECURITY & AUTHENTICATION SECRETS (Server-Side Only)
# ------------------------------------------------------------------------------
# Secret key used to HMAC-hash OTP verification codes before persisting to Firestore
AUTH_CHALLENGE_HMAC_SECRET=your_32_character_random_hmac_secret_here
# Optional admin phone number (E.164 format) to receive WhatsApp notifications on new contact submissions
ADMIN_NOTIFICATION_PHONE_NUMBER=
